# Copy to .env and fill in. Never commit .env.
# Provider: gemini (default) | openai | groq  -- all via the OpenAI-compatible tool-calling API
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0
# Per provider request timeout in seconds (documented default 120)
PROVIDER_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=16384
# Retries for HTTP 429/5xx/connection errors only (timeouts are never retried)
PROVIDER_MAX_RETRIES=4
# Spacing between provider requests, useful on free-tier rate limits
MIN_REQUEST_INTERVAL_SECONDS=2
# Optional: low | medium | high (maps to the provider's reasoning/thinking budget)
LLM_REASONING_EFFORT=
DATABASE_URL=postgresql://claimcheck:claimcheck@127.0.0.1:5433/claimcheck
# Separate database used by the API/DB tests (created automatically by the test fixture)
TEST_DATABASE_URL=postgresql://claimcheck:claimcheck@127.0.0.1:5433/claimcheck_test
